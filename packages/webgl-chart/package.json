{
  "name": "@tomsoftware/webgl-chart",
  "version": "1.1.0",
  "description": "High performance web Chart Library to plot line-charts, area-charts, bubble-charts, bar-chart, rolling charts and annotations using WebGL",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomsoftware/webgl-chart"
  },

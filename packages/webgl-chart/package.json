  "homepage": "https://chart.hmilch.net/",

  "keywords": [
    "chart",
    "webgl"
  ],

  "scripts": {
    "build": "tsc",
    "build:umd": "vite build --config vite.config.umd.ts"
  },
  "dependencies": {
    "@tomsoftware/webgl-lib": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^6.1.0"

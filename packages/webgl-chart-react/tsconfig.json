{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@tomsoftware/webgl-chart": ["../webgl-chart/src"],
      "@tomsoftware/webgl-lib": ["../webgl-lib/src"]
    }
  },
  "include": ["src", "lib"],
  "references": [
    { "path": "../webgl-lib" },
    { "path": "../webgl-chart" }
  ]
}
